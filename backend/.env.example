# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=event_db

# Direct Database URL (Optional override)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/event_db

# API Settings
PROJECT_NAME="College Event Manager API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Environment: development (docs enabled) or production (docs disabled)
ENVIRONMENT=development

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000
